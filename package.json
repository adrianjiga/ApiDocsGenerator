{
  "name": "api-docs-generator",
  "version": "0.0.1",
  "type": "module",
  "description": "Auto-generates API documentation from JavaScript/TypeScript source code",
  "main": "src/index.js",
  "bin": {
    "api-docs-generator": "./bin/api-docs-generator"
  },
  "scripts": {
    "start": "node src/cli.js",
    "generate": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats markdown,html,json",
    "generate:markdown": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats markdown",
    "generate:html": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats html",
    "generate:json": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats json",
    "scan": "node src/cli.js scan ./examples",
    "audit": "node src/cli.js audit --dir ./examples",
    "audit:json": "node src/cli.js audit --dir ./examples --format json",
    "audit:dashboard": "node src/cli.js audit --dir ./examples --format dashboard --output ./examples/docs/coverage-dashboard.html"
  },
  "keywords": [
    "api",
    "documentation",
    "generator",
    "jsdoc",
    "cli"
  ],
  "author": "Adrian Jiga",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "comment-parser": "^1.4.5",
    "espree": "^11.1.0",
    "fs-extra": "^11.3.3"
  },
  "devDependencies": {
    "express": "^5.2.1"
  }
}
