{
  "name": "@adrianjiga/api-docs-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Auto-generates API documentation from JavaScript/TypeScript source code",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "api-docs-generator": "bin/api-docs-generator"
  },
  "scripts": {
    "start": "node src/cli.js",
    "generate": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats markdown,html,json",
    "generate:markdown": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats markdown",
    "generate:html": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats html",
    "generate:json": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats json",
    "generate:openapi": "node src/cli.js generate --dir ./examples --output ./examples/docs --formats openapi",
    "scan": "node src/cli.js scan ./examples",
    "audit": "node src/cli.js audit --dir ./examples",
    "audit:json": "node src/cli.js audit --dir ./examples --format json",
    "audit:self": "node src/cli.js audit --dir ./src --threshold 100",
    "audit:dashboard": "node src/cli.js audit --dir ./examples --format dashboard --output ./examples/docs/coverage-dashboard.html",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check"
  },
  "keywords": [
    "api",
    "documentation",
    "generator",
    "jsdoc",
    "cli"
  ],
  "author": "Adrian Jiga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianjiga/ApiDocsGenerator.git"
  },
  "homepage": "https://github.com/adrianjiga/ApiDocsGenerator#readme",
  "bugs": {
    "url": "https://github.com/adrianjiga/ApiDocsGenerator/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.73.0",
    "commander": "^14.0.2",
    "comment-parser": "^1.4.5",
    "js-yaml": "^4.3.2",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "express": "^5.2.1",
    "vitest": "5.1.0"
  }
}
